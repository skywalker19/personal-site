---
import { getCollection, render } from "astro:content";
import ArchiveBackLink from "../../components/archive/ArchiveBackLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() { const entries = await getCollection("travel", ({ data }) => !data.draft); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry); const date = new Intl.DateTimeFormat("zh-CN", { year:"numeric", month:"long", day:"numeric" }); const label = entry.data.startDate.toDateString() === entry.data.endDate.toDateString() ? date.format(entry.data.startDate) : `${date.format(entry.data.startDate)} — ${date.format(entry.data.endDate)}`;
---
<BaseLayout title={entry.data.title} description={entry.data.summary} canonicalPath={`/travel/${entry.id}/`}><article class="travel-detail page-shell"><header><p class="eyebrow">旅行者 · {label}</p><h1 class="display-title">{entry.data.title}</h1><p class="intro-copy">{entry.data.summary}</p><dl><div><dt>目的地</dt><dd>{entry.data.destinations.join(" · ")}</dd></div>{entry.data.locationContext && <div><dt>位置</dt><dd>{entry.data.locationContext}</dd></div>}</dl></header>{entry.data.hero && <img class="hero-image" src={entry.data.hero.src} width={entry.data.hero.width} height={entry.data.hero.height} alt={entry.data.hero.decorative ? "" : entry.data.hero.alt} loading="eager" />}<div class="prose"><Content /></div>{entry.data.highlights.length > 0 && <section><h2>这一程留下</h2><ul>{entry.data.highlights.map((item) => <li>{item}</li>)}</ul></section>}{entry.data.practicalNotes.length > 0 && <aside><h2>途中备注</h2><ul>{entry.data.practicalNotes.map((item) => <li>{item}</li>)}</ul></aside>}{entry.data.gallery.length > 0 && <section class="gallery" aria-label="照片"><h2>照片</h2>{entry.data.gallery.map((image) => <img src={image.src} width={image.width} height={image.height} alt={image.decorative ? "" : image.alt} loading="lazy" />)}</section>}<ArchiveBackLink href="/travel/" label="返回旅行者档案" /></article></BaseLayout>
<style>.travel-detail { padding-top:clamp(72px,10vw,140px); } header { padding-bottom:44px; border-bottom:1px solid var(--line); } header .intro-copy { margin:38px 0 0 20%; } dl { display:flex; flex-wrap:wrap; gap:20px 48px; margin:38px 0 0 20%; font:11px var(--utility); } dt { color:var(--ink-soft); } dd { margin:6px 0 0; } .prose, section, aside { margin-top:58px; } section h2, aside h2 { font:400 32px var(--display); } aside { max-width:720px; padding:26px 30px; background:var(--paper-raised); border-left:3px solid var(--green); } .gallery { display:grid; gap:18px; } .gallery img,.hero-image { display:block; max-width:100%; height:auto; margin-top:20px; } @media(max-width:720px){header .intro-copy,dl{margin-left:0;}}</style>
