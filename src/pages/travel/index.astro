---
import ArchiveCount from "../../components/archive/ArchiveCount.astro";
import ArchiveEmptyState from "../../components/archive/ArchiveEmptyState.astro";
import ArchiveHeader from "../../components/archive/ArchiveHeader.astro";
import { travelTimeline } from "../../data/travel-timeline";
import BaseLayout from "../../layouts/BaseLayout.astro";
const years = [...new Set(travelTimeline.map((entry) => entry.year))];
const destinations = [...new Set(travelTimeline.map((entry) => entry.destination))];
const monthLabel = (entry: (typeof travelTimeline)[number]) => `${entry.year}年${entry.month}月`;
---
<BaseLayout title="旅行者" description="Calvin 作为旅行者的时间线：去过的地方与停留的天数。" canonicalPath="/travel/"><div class="page-shell"><ArchiveHeader domain="travel" eyebrow="旅行者 · Traveler" title="走过的地方，" accent="留在时间线上。" intro="这是一份轻量的旅行记录：只留下月份、目的地与停留天数。故事留待真正想写的时候再慢慢补上。" />
{travelTimeline.length ? <><div class="travel-controls" aria-label="筛选旅行记录"><label>目的地 <select data-filter="destination"><option value="">全部</option>{destinations.map((value) => <option value={value}>{value}</option>)}</select></label><label>年份 <select data-filter="year"><option value="">全部</option>{years.map((value) => <option value={value}>{value}</option>)}</select></label><button type="button" data-reset>重置筛选</button><ArchiveCount count={travelTimeline.length} singular="段旅行" plural="段旅行" /></div><p class="filter-count" aria-live="polite">显示 {travelTimeline.length} 段旅行</p><ol class="travel-timeline">{travelTimeline.map((entry) => <li class="timeline-item" data-destination={entry.destination} data-year={entry.year}><span class="timeline-dot" aria-hidden="true"></span><article class="timeline-card"><p class="timeline-month">{monthLabel(entry)}</p><h2>{entry.destination}</h2><p class="timeline-days"><strong>{entry.days}</strong><span>天</span></p>{entry.storySlug && <a href={`/travel/${entry.storySlug}/`}>阅读这段旅行 <span aria-hidden="true">→</span></a>}</article></li>)}</ol></> : <ArchiveEmptyState title="第一段旅行还在路上" description="等有一段旅程值得记下，它会从这里开始。" />}</div></BaseLayout>
<script>
  const controls = [...document.querySelectorAll<HTMLSelectElement>("[data-filter]")]; const cards = [...document.querySelectorAll<HTMLElement>(".timeline-item")]; const count = document.querySelector<HTMLElement>(".filter-count");
  function filter() { let visible = 0; cards.forEach((card) => { const matches = controls.every((control) => !control.value || (control.dataset.filter === "year" ? card.dataset.year : card.dataset.destination) === control.value); card.hidden = !matches; if (matches) visible++; }); if (count) count.textContent = `显示 ${visible} 段旅行`; }
  controls.forEach((control) => control.addEventListener("change", filter)); document.querySelector("[data-reset]")?.addEventListener("click", () => { controls.forEach((control) => control.value = ""); filter(); });
</script>
<style>.travel-controls { display:flex; flex-wrap:wrap; gap:14px 20px; align-items:end; padding:22px 0; border-block:1px solid var(--line); font:10px var(--utility); letter-spacing:.06em; } label { display:grid; gap:6px; } select,button { color:var(--ink); background:var(--paper-raised); border:1px solid var(--line); padding:8px; font:inherit; } .filter-count { margin:18px 0 28px; color:var(--ink-soft); font:11px var(--utility); } .travel-timeline { position:relative; display:grid; gap:20px; margin:0; padding:0 0 0 clamp(26px,7vw,86px); list-style:none; } .travel-timeline::before { content:""; position:absolute; top:10px; bottom:10px; left:clamp(9px,2.5vw,32px); width:1px; background:var(--line); } .timeline-item { position:relative; } .timeline-dot { position:absolute; top:34px; left:calc(-1 * clamp(26px,7vw,86px) + clamp(9px,2.5vw,32px) - 5px); width:11px; height:11px; border:2px solid var(--paper); border-radius:50%; background:var(--green); box-shadow:0 0 0 1px var(--green); } .timeline-card { display:grid; grid-template-columns:1fr auto; align-items:center; gap:8px 24px; min-height:150px; padding:28px clamp(24px,5vw,54px); border:1px solid var(--line); background:var(--paper-raised); } .timeline-month { margin:0; color:var(--ink-soft); font:10px var(--utility); letter-spacing:.12em; } h2 { margin:0; font:400 clamp(36px,5vw,66px)/.95 var(--display); letter-spacing:-.05em; } .timeline-days { grid-column:2; grid-row:1 / span 2; display:flex; align-items:baseline; gap:6px; margin:0; } .timeline-days strong { font:400 clamp(44px,6vw,74px)/.8 var(--display); letter-spacing:-.06em; } .timeline-days span { font:12px var(--utility); } .timeline-card a { grid-column:1 / -1; margin-top:8px; font:10px var(--utility); letter-spacing:.08em; text-underline-offset:5px; } @media (max-width:560px) { .travel-timeline { padding-left:35px; } .travel-timeline::before { left:5px; } .timeline-dot { left:-35px; } .timeline-card { min-height:124px; padding:22px; } }</style>
