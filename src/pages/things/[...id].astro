---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EpisodeSet from "../../components/EpisodeSet.astro";
import StatusBadge from "../../components/StatusBadge.astro";

export async function getStaticPaths() {
  const things = await getCollection("things", ({ data }) => !data.draft);
  return things.map((thing) => ({ params: { id: thing.id }, props: { thing } }));
}

interface Props { thing: CollectionEntry<"things">; }
const { thing } = Astro.props;
const { Content } = await render(thing);
const dates = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long" });
const primaryTitle = thing.data.titleZh || thing.data.title;
const primarySummary = thing.data.summaryZh || thing.data.summary;
const typeLabels = { project: "项目", podcast: "播客", writing: "写作", system: "系统", idea: "想法" };
---

<BaseLayout title={primaryTitle} description={primarySummary}>
  <article>
    <header class={`thing-hero tone-${thing.data.tone}`}>
      <div class="page-shell thing-hero-inner">
        <div class="thing-hero-copy">
          <div class="thing-meta">
            <StatusBadge status={thing.data.status} cadence={thing.data.cadence} />
            <span>{typeLabels[thing.data.type]}</span>
            <span>{dates.format(thing.data.started)} — {thing.data.finished ? dates.format(thing.data.finished) : "现在"}</span>
          </div>
          <h1>{primaryTitle}</h1>
          {thing.data.titleZh && <p class="title-zh" lang="en">{thing.data.title}</p>}
          <p class="deck">{primarySummary}</p>
        </div>
        <div class="hero-mark" aria-hidden="true">{thing.data.mark}</div>
      </div>
    </header>

    <div class="thing-body page-shell">
      <aside>
        <p class="kicker">相关主题</p>
        <ul>{thing.data.themes.map((theme) => <li>{theme}</li>)}</ul>
        {thing.data.links.length > 0 && (
          <>
            <p class="kicker link-kicker">打开</p>
            <ul class="external-links">
              {thing.data.links.map((link) => <li><a href={link.url} rel="noreferrer">{link.label} ↗</a></li>)}
            </ul>
          </>
        )}
      </aside>
      <div class="prose">
        <Content />
        {thing.data.report && (
          <section class="overall-report" aria-labelledby="overall-report-title">
            <p class="kicker">Overall report</p>
            <h2 id="overall-report-title">The word bank, together</h2>
            <p>See the aggregate record across Miller Words sessions, separate from the individual story practice.</p>
            <a class="report-link" href={thing.data.report.url}>
              {thing.data.report.label} <span aria-hidden="true">↗</span>
            </a>
          </section>
        )}
        {thing.data.episodes.length > 0 && <EpisodeSet episodes={thing.data.episodes} />}
      </div>
    </div>
  </article>
  <div class="back page-shell"><a href="/things/">← 返回全部小事</a></div>
</BaseLayout>

<style>
  .thing-hero { --tone: var(--slate); color: var(--paper-raised); background: var(--tone); }
  .thing-hero-inner { display: grid; grid-template-columns: 1fr .35fr; min-height: 590px; }
  .thing-hero-copy { align-self: end; padding-block: 100px 82px; }
  .thing-meta { display: flex; flex-wrap: wrap; gap: 18px; margin-bottom: 34px; font: 10px var(--utility); letter-spacing: .08em; text-transform: uppercase; }
  .thing-meta :global(.status) { color: inherit; }
  h1 { max-width: 820px; margin: 0; font-family: var(--display); font-size: clamp(58px, 8vw, 108px); font-weight: 400; line-height: .94; letter-spacing: -.055em; }
  .title-zh { margin: 12px 0 0; font: 26px var(--display); opacity: .8; }
  .deck { max-width: 660px; margin: 42px 0 0; font-size: 20px; line-height: 1.6; opacity: .88; }
  .hero-mark { display: grid; place-items: center; font: clamp(110px, 17vw, 230px)/1 var(--display); opacity: .18; }
  .thing-body { display: grid; grid-template-columns: .3fr 1fr; gap: 70px; padding-block: 110px 150px; }
  aside { color: var(--ink-soft); font-size: 13px; }
  aside ul { margin: 0; padding: 0; list-style: none; }
  aside li { margin-bottom: 8px; }
  .link-kicker { margin-top: 40px; }
  .external-links a { text-underline-offset: 4px; }
  .overall-report { margin-top: 72px; padding: 28px 30px 32px; background: color-mix(in srgb, var(--gold) 9%, transparent); border: 1px solid color-mix(in srgb, var(--gold) 34%, var(--line)); }
  .overall-report .kicker { margin-bottom: 12px; }
  .overall-report h2 { margin: 0; font-family: var(--display); font-size: clamp(30px, 4vw, 42px); font-weight: 400; letter-spacing: -.035em; }
  .overall-report p:not(.kicker) { margin: 16px 0 22px; color: var(--ink-soft); }
  .report-link { font-family: var(--utility); font-size: 11px; letter-spacing: .06em; text-underline-offset: 5px; text-transform: uppercase; }
  .back { padding-bottom: 90px; font: 11px var(--utility); letter-spacing: .05em; }
  .back a { text-underline-offset: 5px; }
  @media (max-width: 720px) {
    .thing-hero-inner { grid-template-columns: 1fr; min-height: 520px; }
    .hero-mark { display: none; }
    .thing-body { grid-template-columns: 1fr; gap: 50px; }
    .overall-report { margin-top: 54px; padding: 24px 22px 26px; }
  }
</style>
