---
import ArchiveCount from "../../components/archive/ArchiveCount.astro";
import ArchiveEmptyState from "../../components/archive/ArchiveEmptyState.astro";
import ArchiveHeader from "../../components/archive/ArchiveHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getReadingSnapshot, type ReadingItem } from "../../lib/reading";
const reading = getReadingSnapshot();
const hasItems = reading.current.length + reading.completedThisYear.length + reading.history.length > 0;
const metadata = (item: ReadingItem) => [["作者", item.author], ["出版社", item.publisher], ["国家", item.country], ["媒介", item.medium], ["类型", item.types?.join(" · ")], ["语言", item.language], ["我的评分", item.rating], ["豆瓣", item.doubanScore && `${item.doubanScore} / 10`]].filter(([, value]) => value) as [string, string][];
---
<BaseLayout title="阅读者" description="Calvin 作为阅读者的记录：正在读的书、今年读完的书，以及往年的阅读数量。" canonicalPath="/reading/"><div class="page-shell"><ArchiveHeader domain="reading" eyebrow="阅读者 · Reader" title="书页载我远行，" accent="灯下也有另一种天涯。" intro="“没有哪一艘护卫舰，能像一本书那样，带我们远行。”——艾米莉·狄金森（意译）。这里记录正在阅读的书、今年读完的书，以及往年的阅读数量；只留下适合公开的书目信息，不公开阅读日期与私人笔记。" />
{hasItems ? <div class="reading-ledger"><section aria-labelledby="current-title"><div class="ledger-heading"><h2 id="current-title">此刻翻开的书</h2><ArchiveCount count={reading.current.length} singular="本" /></div>{reading.current.length ? <ul class="book-list">{reading.current.map((item) => <li><h3>{item.title}</h3>{metadata(item).length > 0 && <dl>{metadata(item).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}</li>)}</ul> : <p class="empty-copy">此刻没有公开的在读书目，书页正等待下一次翻开。</p>}</section><section aria-labelledby="completed-title"><div class="ledger-heading"><h2 id="completed-title">今年走过的书页</h2><ArchiveCount count={reading.completedThisYear.length} singular="本" /></div>{reading.completedThisYear.length ? <ul class="book-list">{reading.completedThisYear.map((item) => <li><h3>{item.title}</h3>{metadata(item).length > 0 && <dl>{metadata(item).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}</li>)}</ul> : <p class="empty-copy">今年的阅读会在合上最后一页后，留在这里。</p>}</section><section aria-labelledby="history-title"><div class="ledger-heading"><h2 id="history-title">往年留下的刻度</h2></div>{reading.history.length ? <ol class="history-list">{reading.history.map((year) => <li><span>{year.year}</span><strong>{year.count} 本</strong></li>)}</ol> : <p class="empty-copy">更长的阅读刻度仍在整理。</p>}</section></div> : <ArchiveEmptyState title="书页正在整理中" description="第一份公开阅读记录还没有放进来。这个空白是有意保留的：等内容准备好，正在阅读、今年已读与往年阅读会在这里展开。" />}</div></BaseLayout>
<style>.reading-ledger { border-top:1px solid var(--line); } .reading-ledger section { padding-block:50px; border-bottom:1px solid var(--line); } .ledger-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; } h2 { margin:0; font:400 clamp(32px,4vw,50px)/1 var(--display); letter-spacing:-.03em; } .book-list { margin:28px 0 0; padding:0; list-style:none; } .book-list li { padding:20px 0; border-top:1px solid var(--line); } h3 { margin:0; font:400 25px var(--display); } dl { display:flex; flex-wrap:wrap; gap:8px 20px; margin:13px 0 0; color:var(--ink-soft); font:10px var(--utility); } dl div { display:flex; gap:6px; } dt { color:var(--ink); } dd { margin:0; } .history-list { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1px; margin:28px 0 0; padding:1px; list-style:none; background:var(--line); } .history-list li { display:flex; justify-content:space-between; padding:20px; background:var(--paper); font-family:var(--utility); } .history-list strong { font-weight:400; } .empty-copy { color:var(--ink-soft); line-height:1.7; }</style>
