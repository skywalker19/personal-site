---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThingCard from "../components/ThingCard.astro";
import ArchiveCard from "../components/archive/ArchiveCard.astro";
import { getReadingSnapshot } from "../lib/reading";
import { travelTimeline } from "../data/travel-timeline";
import { compareThings, statusLabels } from "../status";

const things = (await getCollection("things", ({ data }) => !data.draft)).sort(compareThings);
const featured = things.filter(({ data }) => data.featured).slice(0, 4);
const current = things.filter(({ data }) => ["ongoing", "building", "exploring"].includes(data.status));
const buildMonth = new Intl.DateTimeFormat("zh-CN", { month: "long", year: "numeric" }).format(new Date());
const reading = getReadingSnapshot();
const latestTravel = travelTimeline[0];
---

<BaseLayout>
  <section class="hero page-shell">
    <p class="eyebrow">日常的河流 · A personal archive</p>
    <h1 class="display-title">做过、读过、走过，<br /><em>让时间留下回声。</em></h1>
    <div class="hero-foot">
      <p class="intro-copy">
        把一些小小的念头交给双手，把一些遥远的世界交给书页，也把走过的地方交给时间。这里收集已经完成的、尚未完成的，以及仍在生长的生活片段。
      </p>
      <p class="intro-zh" lang="en">Small tools, borrowed worlds, and roads that keep unfolding.</p>
    </div>
  </section>

  <section class="archive-portals page-shell" aria-labelledby="archive-portals-title">
    <div class="section-heading">
      <div>
        <p class="kicker">三种回声 · Three archives</p>
        <h2 id="archive-portals-title">同一段生活，三种回声</h2>
      </div>
    </div>
    <div class="portal-list">
      <ArchiveCard
        domain="things"
        role="Maker"
        roleZh="创客"
        description="把念头交给双手，让它们长成可使用的小事。‘你必须找到你所热爱的。不要将就。’——史蒂夫·乔布斯"
        href="/things/"
        linkLabel="打开创客档案"
        count={`${things.length} 件`}
      />
      <ArchiveCard
        domain="reading"
        role="Reader"
        roleZh="阅读者"
        description={reading.current.length ? `让书页替我远行。正在读：${reading.current.map((item) => item.title).join("、")}。` : `让书页替我远行；今年已读 ${reading.completedThisYear.length} 本，往年的阅读留成安静的刻度。`}
        href="/reading/"
        linkLabel="打开阅读者记录"
        count={reading.current.length ? `${reading.current.length} 本在读` : `今年 ${reading.completedThisYear.length} 本`}
      />
      <ArchiveCard
        domain="travel"
        role="Traveler"
        roleZh="旅行者"
        description={latestTravel ? `让脚步丈量远方，让月份替旅程留名。最近一程：${latestTravel.year}年${latestTravel.month}月 · ${latestTravel.destination} · ${latestTravel.days}天。` : "让脚步丈量远方，让去过的地方在这里留下一笔。"}
        href="/travel/"
        linkLabel="打开旅行者记录"
        count={latestTravel ? `${travelTimeline.length} 段` : "待出发"}
      />
    </div>
  </section>

  <section class="now page-shell" aria-labelledby="now-title">
    <div class="now-label">
      <span class="pulse" aria-hidden="true"></span>
      <h2 id="now-title">此刻，光落在这里</h2>
      <span>{buildMonth}</span>
    </div>
    <div class="now-list">
      {current.slice(0, 3).map((thing) => (
        <a href={`/things/${thing.id}/`}>
          <span>{thing.data.titleZh || thing.data.title}</span>
          <small>{statusLabels[thing.data.status].zh}{thing.data.cadence ? ` · ${thing.data.cadence}` : ""}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="selected page-shell" aria-labelledby="selected-title">
    <div class="section-heading">
      <div>
        <p class="kicker">从时间里挑选 · Selected</p>
        <h2 id="selected-title">捞起几件仍在发光的小事</h2>
      </div>
      <a href="/things/">查看全部 {things.length} 件 →</a>
    </div>
    <div class="ledger">
      {featured.map((thing, index) => (
        <div class="ledger-entry">
          <div class="ledger-index" aria-hidden="true">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <i></i>
          </div>
          <ThingCard thing={thing} showYear />
        </div>
      ))}
    </div>
  </section>

  <section class="archive-invite page-shell">
    <p class="kicker">把微小交给时间</p>
    <p>不是每件事都要惊天动地，才值得被记住。</p>
    <a href="/things/">去档案里走走 <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(80px, 12vw, 170px) 90px; }
  .hero-foot { display: grid; grid-template-columns: 1.4fr .6fr; gap: 60px; align-items: end; margin-top: 66px; padding-left: 20%; }
  .hero-foot p { margin-block: 0; }
  .intro-zh { color: var(--ink-soft); font-family: var(--display); font-size: 17px; line-height: 1.8; }
  .now { display: grid; grid-template-columns: .38fr 1fr; border-block: 1px solid var(--line); }
  .now-label { display: grid; grid-template-columns: auto 1fr; align-content: center; column-gap: 12px; padding: 34px 38px 34px 0; border-right: 1px solid var(--line); }
  .now-label h2 { margin: 0; font-family: var(--utility); font-size: 12px; letter-spacing: .13em; text-transform: uppercase; }
  .now-label > span:last-child { grid-column: 2; margin-top: 5px; color: var(--ink-soft); font-family: var(--utility); font-size: 10px; }
  .pulse { align-self: center; width: 9px; height: 9px; background: #3d8062; border-radius: 50%; box-shadow: 0 0 0 5px rgba(61, 128, 98, .12); }
  .now-list { display: grid; grid-template-columns: repeat(3, 1fr); }
  .now-list a { display: flex; flex-direction: column; justify-content: center; min-height: 112px; padding: 25px 32px; text-decoration: none; border-right: 1px solid var(--line); }
  .now-list a:last-child { border: 0; }
  .now-list a:hover { background: var(--paper-raised); }
  .now-list span { font-family: var(--display); font-size: 21px; }
  .now-list small { margin-top: 7px; color: var(--ink-soft); font-family: var(--utility); font-size: 9px; letter-spacing: .06em; text-transform: uppercase; }
  .selected { padding-block: clamp(90px, 12vw, 160px); }
  .archive-portals { padding-block: clamp(90px, 11vw, 142px) 0; }
  .portal-list { display:grid; grid-template-columns:repeat(3, 1fr); gap:18px; }
  .ledger-entry { display: grid; grid-template-columns: 72px 1fr; }
  .ledger-index { position: relative; color: var(--ink-soft); font-family: var(--utility); font-size: 10px; }
  .ledger-index span { position: absolute; top: 19px; left: 0; }
  .ledger-index i { position: absolute; top: 0; bottom: 0; right: 31px; width: 1px; background: var(--line); }
  .ledger-index i::before { content: ""; position: absolute; top: 20px; left: -4px; width: 9px; height: 9px; background: var(--paper); border: 2px solid var(--ink); border-radius: 50%; }
  .archive-invite { display: grid; grid-template-columns: .45fr 1fr auto; gap: 40px; align-items: center; padding-block: 74px; border-top: 1px solid var(--line); }
  .archive-invite p { margin: 0; }
  .archive-invite > p:nth-child(2) { max-width: 560px; font-family: var(--display); font-size: clamp(25px, 3vw, 40px); line-height: 1.2; }
  .archive-invite a { font-family: var(--utility); font-size: 11px; letter-spacing: .06em; text-underline-offset: 5px; }
  @media (max-width: 820px) {
    .hero-foot { grid-template-columns: 1fr; gap: 22px; padding-left: 0; }
    .now { grid-template-columns: 1fr; }
    .now-label { border-right: 0; border-bottom: 1px solid var(--line); }
    .now-list { grid-template-columns: 1fr; }
    .now-list a { min-height: 88px; padding-inline: 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .archive-invite { grid-template-columns: 1fr; }
    .portal-list { grid-template-columns:1fr; gap:0; border-bottom:1px solid var(--line); }
    .portal-list :global(.archive-card) { border-bottom:0; }
  }
  @media (max-width: 560px) {
    .ledger-entry { grid-template-columns: 34px 1fr; }
    .ledger-index i { right: 15px; }
    .ledger-index span { display: none; }
    .section-heading { align-items: flex-end; }
    .section-heading a { max-width: 90px; text-align: right; }
  }
</style>
