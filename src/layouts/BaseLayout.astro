---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "日积小事",
  description = "Calvin 持续生长的个人档案：项目、实验与写作。",
} = Astro.props;

const pageTitle = title === "日积小事" ? `${title} · Small Things, Over Time` : `${title} — 日积小事`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111d27" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="日积小事 — 首页">
        <span class="wordmark-mark" aria-hidden="true">日</span>
        <span>
          <strong>日积小事</strong>
          <small>Small Things, Over Time</small>
        </span>
      </a>
      <nav aria-label="主导航">
        <a href="/things/" aria-current={Astro.url.pathname.startsWith("/things") ? "page" : undefined}>小事</a>
        <a href="/about/" aria-current={Astro.url.pathname === "/about/" ? "page" : undefined}>关于</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>慢慢做，值得记住时就回来更新。</p>
      <p><span aria-hidden="true">↳</span> Calvin · 杭州</p>
    </footer>
  </body>
</html>
