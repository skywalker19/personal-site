---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  socialImage?: string;
}

const {
  title = "日积小事",
  description = "Calvin 持续生长的个人档案：创客、阅读者与旅行者。",
  canonicalPath = Astro.url.pathname,
  socialImage,
} = Astro.props;

const pageTitle = title === "日积小事" ? `${title} · Small Things, Over Time` : `${title} — 日积小事`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const socialImageURL = socialImage ? new URL(socialImage, Astro.site) : undefined;
const pathname = Astro.url.pathname;
const isCurrent = (route: string) => pathname === route || (route !== "/" && pathname.startsWith(route));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111d27" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="日积小事" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta name="twitter:card" content={socialImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="日积小事 — 首页">
        <span class="wordmark-mark" aria-hidden="true">日</span>
        <span>
          <strong>日积小事</strong>
          <small>Small Things, Over Time</small>
        </span>
      </a>
      <nav aria-label="主导航">
        <a href="/things/" aria-current={isCurrent("/things/") ? "page" : undefined}><span>创客</span><small lang="en">Maker</small></a>
        <a href="/reading/" aria-current={isCurrent("/reading/") ? "page" : undefined}><span>阅读者</span><small lang="en">Reader</small></a>
        <a href="/travel/" aria-current={isCurrent("/travel/") ? "page" : undefined}><span>旅行者</span><small lang="en">Traveler</small></a>
        <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}><span>关于</span><small lang="en">About</small></a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>慢慢做，值得记住时就回来更新。</p>
      <p><span aria-hidden="true">↳</span> Calvin · 杭州</p>
    </footer>
  </body>
</html>
