---
interface Props {
  domain: "things" | "reading" | "travel";
  role: string;
  roleZh: string;
  description: string;
  href: string;
  linkLabel: string;
  count?: string;
}

const { domain, role, roleZh, description, href, linkLabel, count } = Astro.props;
const roleArtwork = {
  things: "/assets/role-maker-logo-2.jpeg",
  reading: "/assets/role-reader-logo-2.jpeg",
  travel: "/assets/role-traveler-logo-2.jpeg",
}[domain];
---

<article class="archive-card" data-archive-domain={domain}>
  <div class="archive-card-art" aria-hidden="true"><img src={roleArtwork} alt="" /></div>
  <div class="archive-card-copy">
    <h3><a href={href}><span lang="en">{role}</span><strong>{roleZh}</strong></a></h3>
    <p>{description}</p>
    <div class="archive-card-foot">{count && <small>{count}</small>}<a href={href}>{linkLabel} <span aria-hidden="true">→</span></a></div>
  </div>
</article>

<style>
  .archive-card { --archive-accent: var(--blue); --archive-wash: #e8efff; display:grid; grid-template-rows: minmax(208px, .96fr) 1.04fr; min-height:470px; border:1px solid var(--line); background:var(--paper-raised); }
  [data-archive-domain="reading"] { --archive-accent: #bd731d; --archive-wash: #fff0dc; }
  [data-archive-domain="travel"] { --archive-accent: #36745a; --archive-wash: #e4f1e9; }
  .archive-card-art { display:grid; place-items:center; padding:clamp(30px,4vw,52px); background:linear-gradient(145deg, var(--archive-wash), var(--paper-raised)); border-bottom:1px solid var(--line); }
  .archive-card-art img { display:block; width:min(100%, 178px); max-height:172px; object-fit:contain; filter:drop-shadow(0 13px 18px rgba(20,34,45,.12)); transition:transform 220ms ease; }
  .archive-card:hover .archive-card-art img { transform:translateY(-5px) scale(1.03); }
  .archive-card-copy { display:flex; flex-direction:column; padding:clamp(26px,3.3vw,42px); }
  h3 { margin:0; }
  h3 a { display:inline-flex; flex-direction:column; gap:9px; text-decoration:none; }
  h3 span { color:var(--archive-accent); font:11px var(--utility); letter-spacing:.14em; text-transform:uppercase; }
  h3 strong { font:400 clamp(39px,3.7vw,54px)/.92 var(--display); letter-spacing:-.05em; }
  p { margin:20px 0 0; color:var(--ink-soft); font-size:14px; line-height:1.72; }
  .archive-card-foot { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:auto; padding-top:24px; border-top:1px solid var(--line); }
  .archive-card-foot small { color:var(--ink-soft); font:10px var(--utility); letter-spacing:.08em; }
  .archive-card-foot a { font:10px var(--utility); letter-spacing:.08em; text-underline-offset:5px; }
  @media (max-width:820px) { .archive-card { grid-template-columns:170px 1fr; grid-template-rows:1fr; min-height:220px; } .archive-card-art { padding:24px; border-right:1px solid var(--line); border-bottom:0; } .archive-card-art img { max-height:118px; } .archive-card-copy { padding:26px; } h3 a { flex-direction:row; align-items:baseline; gap:12px; } h3 strong { font-size:42px; } p { margin-top:13px; } }
  @media (max-width:480px) { .archive-card { grid-template-columns:118px 1fr; } .archive-card-art { padding:15px; } .archive-card-art img { max-height:82px; } .archive-card-copy { padding:20px; } h3 a { flex-direction:column; gap:5px; } h3 strong { font-size:35px; } .archive-card-foot { padding-top:16px; } .archive-card-foot small { display:none; } }
</style>
