---
interface Props { href: string; label: string; }
const { href, label } = Astro.props;
---

<nav class="archive-back" aria-label="档案返回导航"><a href={href}>← {label}</a></nav>

<style>
  .archive-back { padding-block: 30px 80px; font: 10px var(--utility); letter-spacing: .06em; text-transform: uppercase; }
  a { text-underline-offset: 5px; }
</style>
